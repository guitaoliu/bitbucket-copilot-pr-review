{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
    "group:allNonMajor",
    "schedule:weekly",
    ":maintainLockFilesWeekly",
    ":disablePeerDependencies",
  ],
  labels: [
    "dependencies"
  ],
  postUpdateOptions: [
    "pnpmDedupe"
  ],
  packageRules: [
    {
      groupName: 'github-actions',
      matchManagers: [
        'github-actions',
      ],
    },
  ]
}