{
	"name": "bitbucket-copilot-pr-review",
	"version": "0.7.6",
	"description": "CLI-first Bitbucket Data Center pull request review with GitHub Copilot SDK",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/guitaoliu/bitbucket-copilot-pr-review.git"
	},
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@11.11.0",
	"bin": {
		"bitbucket-copilot-pr-review": "dist/cli.js"
	},
	"files": [
		"dist",
		"schemas",
		"README.md"
	],
	"engines": {
		"node": ">=24.12.0",
		"pnpm": ">=10.29.2"
	},
	"scripts": {
		"build": "tsdown",
		"prepack": "pnpm build",
		"typecheck": "tsc -p tsconfig.json",
		"check": "biome check",
		"check:fix": "biome check --fix",
		"knip": "knip --production --no-progress",
		"generate:config-docs": "node scripts/generate-config-docs.mjs",
		"release:check": "node scripts/release-check.mjs",
		"verify": "pnpm release:check",
		"review": "pnpm build && node dist/cli.js review",
		"review:dry-run": "pnpm build && node dist/cli.js review --dry-run",
		"review:src": "node src/cli.ts review",
		"review:src:dry-run": "node src/cli.ts review --dry-run",
		"generate:repo-config-schema": "node scripts/generate-repo-config-schema.mjs",
		"test": "node --test \"src/**/*.test.ts\""
	},
	"dependencies": {
		"@github/copilot": "1.0.70",
		"pino": "10.3.1",
		"pino-pretty": "13.1.3",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@github/copilot-sdk": "1.0.6",
		"@types/node": "24.13.3",
		"knip": "6.26.0",
		"tsdown": "0.22.4",
		"typescript": "6.0.3"
	}
}
