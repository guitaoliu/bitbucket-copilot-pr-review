{
	"name": "bitbucket-copilot-pr-review",
	"version": "0.8.4",
	"description": "CLI-first Bitbucket Data Center pull request review with GitHub Copilot SDK",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/guitaoliu/bitbucket-copilot-pr-review.git"
	},
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
	"bin": {
		"bitbucket-copilot-pr-review": "dist/cli.js"
	},
	"files": [
		"dist",
		"schemas",
		"README.md"
	],
	"engines": {
		"node": ">=24.12.0",
		"pnpm": ">=10.29.2"
	},
	"scripts": {
		"build": "tsdown",
		"prepack": "pnpm build",
		"typecheck": "tsc -p tsconfig.json",
		"check": "biome check",
		"check:fix": "biome check --fix",
		"knip": "knip --production --no-progress",
		"generate:config-docs": "node scripts/generate-config-docs.mjs",
		"release:check": "node scripts/release-check.mjs",
		"verify": "pnpm release:check",
		"review": "pnpm build && node dist/cli.js review",
		"review:dry-run": "pnpm build && node dist/cli.js review --dry-run",
		"generate:repo-config-schema": "node scripts/generate-repo-config-schema.mjs",
		"test:build": "tsdown --config tsdown.test.config.ts",
		"test": "pnpm test:build && node --test \".test-dist/**/*.test.mjs\""
	},
	"dependencies": {
		"@github/copilot": "1.0.75",
		"@github/copilot-sdk": "1.0.8",
		"pino": "10.3.1",
		"pino-pretty": "13.1.3",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/node": "24.13.3",
		"knip": "6.29.0",
		"tsdown": "0.22.14",
		"typescript": "7.0.2"
	}
}
